# Framework 13: keep all apps, terminals, tabs, and workspace assignments.
# Use full-width Hyprland window tabs instead of narrow tiled columns.
PL_LAYOUT=laptop

# For automatic switching when docking to an ultrawide, change the line above
# to PL_LAYOUT=auto. The threshold is measured after display scaling.
PL_LAPTOP_MAX_WIDTH=1920
PL_LAYOUT_WAIT_ATTEMPTS=60
